.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*.bak

# root-level scratch scripts from interactive debugging
/_*.py
scripts/_*.py

# tsc build output beside the vite config source
frontend/vite.config.js
frontend/vite.config.d.ts
